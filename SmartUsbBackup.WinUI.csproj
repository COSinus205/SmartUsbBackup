<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smart USB Backup 2.0 — WinUI 3 / Windows App SDK (Unpackaged).

    Почему так:
      • WinUI 3 даёт Fluent-интерфейс Windows 11 (Mica, скругления, ContentDialog, Pickers).
      • Unpackaged (WindowsPackageType=None) — классический .exe без MSIX: работает
        с Inno Setup и «Параметры → Приложения».
      • WindowsAppSDKSelfContained=true — среда Windows App SDK кладётся РЯДОМ с .exe
        (отдельного установщика WinAppSDK Runtime не требуется).
      • SelfContained=true — внутри .exe зашит рантайм .NET 8.

    ВАЖНО про «один .exe»:
      PublishSingleFile для WinUI 3 НЕ поддерживается — нативные модули WinUI
      (Microsoft.ui.xaml.dll и др.) обязаны лежать на диске рядом с exe.
      Поэтому `dotnet publish` даёт ПАПКУ (bin/publish/*), которую инсталлятор Inno Setup
      упаковывает в ЕДИНСТВЕННЫЙ установочный Setup.exe — на машине пользователя при этом
      ничего дополнительно ставить не нужно (ни .NET 8, ни Windows App SDK).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>

    <!-- Строго x64, Windows 11 -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>

    <!-- WinUI 3, без упаковки в MSIX -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- .NET 8 рантайм внутри (self-contained), без trim: рефлексия+xaml -->
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <AssemblyName>SmartUsbBackup</AssemblyName>
    <RootNamespace>SmartUsbBackup</RootNamespace>
    <Version>3.0.0</Version>
    <Company>Smart USB Backup</Company>
    <Product>Smart USB Backup</Product>
    <Description>Зеркальное резервное копирование USB-флешек (WinUI 3, событийная модель, 0% CPU в простое)</Description>



    <!-- Имя файла ресурсов: WinUI 3 (unpackaged) ищет resources.pri рядом с .exe -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>

    <!-- Единая папка публикации для инсталлятора -->
    <PublishDir>$(MSBuildThisFileDirectory)bin\publish\</PublishDir>
  </PropertyGroup>

  <!--
    dotnet publish не переносит resources.pri в папку публикации (в отличие от обычной сборки),
    поэтому копируем его вручную. Без resources.pri WinUI не находит XBF и падает с
    XamlParseException "Cannot locate resource from 'ms-appx:///MainWindow.xaml'".
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(ProjectPriFileName)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(ProjectPriFileName)')" />
  </Target>

  <!-- Иконка трея/окна должна попасть и в publish (иначе TaskbarIcon падает с DirectoryNotFound) -->
  <ItemGroup>
    <Content Update="Assets\appicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK (стабильная ветка 1.6; при необходимости поменяйте версию) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- Трей реализован собственным NativeTrayIcon (Shell_NotifyIcon + нативное меню):
         H.NotifyIcon 2.3.2 на WinUI 3 1.8 не доставлял клики по пунктам меню. -->
  </ItemGroup>

</Project>
