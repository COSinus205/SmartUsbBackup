<?xml version="1.0" encoding="utf-8"?>
<!--
  Smart USB Backup — главное окно (WinUI 3).

  Шаг 2 (исправление): TabView — корневой элемент окна, он занимает всё пространство.
  Иконка и название помещены в TabStripHeader, пустая drag-зона (DragRegion) —
  в TabStripFooter, справа от вкладок; системные кнопки учитываются через RightInset.
-->
<Window
    x:Class="SmartUsbBackup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:SmartUsbBackup.Core"
    Title="Smart USB Backup">

  <TabView
      x:Name="MainTabView"
      IsAddTabButtonVisible="False"
      Background="Transparent"
      Padding="0"
      TabCloseRequested="MainTabView_TabCloseRequested">

    <!-- Левая часть верхней полосы: иконка + название программы -->
    <TabView.TabStripHeader>
      <StackPanel
          x:Name="TitleArea"
          Orientation="Horizontal"
          Spacing="8"
          VerticalAlignment="Center"
          Margin="12,0,8,0">
        <Image
            Source="Assets/appicon.ico"
            Width="16"
            Height="16"
            VerticalAlignment="Center" />
        <TextBlock
            Text="Smart USB Backup"
            VerticalAlignment="Center"
            FontSize="12"
            Opacity="0.8" />
      </StackPanel>
    </TabView.TabStripHeader>

    <TabView.TabStripFooter>
      <Border x:Name="TabStripSpacer"
              Width="0"
              Background="Transparent" />
    </TabView.TabStripFooter>

    <TabViewItem Header="Синхронизация" IsClosable="False">
      <Grid x:Name="RootGrid" Padding="16,10,16,14" RowSpacing="10" >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />  <!-- 0: путь -->
          <RowDefinition Height="Auto" />  <!-- 1: кнопки -->
          <RowDefinition Height="Auto" />  <!-- 2: прогресс -->
          <RowDefinition Height="*"   />  <!-- 3: список флешек -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: Папка бэкапов ==================== -->
        <Grid Grid.Row="0" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock
              Grid.Column="0"
              Text="Папка бэкапов:"
              VerticalAlignment="Center" />

          <TextBox
              x:Name="TxtBackupPath"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              IsReadOnly="True"
              Text=""
              VerticalAlignment="Center" />

          <Button
              x:Name="BtnBrowse"
              Grid.Column="2"
              Content="Обзор..."
              Click="OnBrowseClicked"
              VerticalAlignment="Center" />
        </Grid>

        <!-- ==================== ROW 1: Кнопки действий ==================== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
          <Button
              x:Name="BtnSyncAll"
              Content="Синхронизировать всё сейчас"
              Style="{StaticResource AccentButtonStyle}"
              Click="OnSyncAllClicked" />
          <Button
              x:Name="BtnWipeSelected"
              Content="Удалить бэкап выбранной"
              IsEnabled="False"
              Click="OnWipeSelectedClicked" />
        </StackPanel>

        <!-- ==================== ROW 2: Блок прогресса ==================== -->
        <Grid Grid.Row="2" RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 3.1: полоса прогресса -->
            <RowDefinition Height="Auto" />  <!-- 3.2: текст -->
          </Grid.RowDefinitions>

          <ProgressBar
              x:Name="ProgressSync"
              Grid.Row="0"
              Maximum="100"
              Value="0"
              IsIndeterminate="False"
              HorizontalAlignment="Stretch" />

          <TextBlock
              x:Name="TxtStatus"
              Grid.Row="1"
              HorizontalAlignment="Stretch"
              MaxLines="2"
              TextTrimming="CharacterEllipsis"
              TextWrapping="Wrap"
              Text="Ожидание флешки…" />
        </Grid>

        <!-- ==================== ROW 4: Список флешек ==================== -->
        <Border
            Grid.Row="3"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*"   />
            </Grid.RowDefinitions>

            <!-- Шапка таблицы -->
            <Grid Grid.Row="0" Padding="12,7,12,7" ColumnSpacing="10"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="25*" />
                  <ColumnDefinition Width="15*" />
                  <ColumnDefinition Width="15*" />
                  <ColumnDefinition Width="10*" />
                  <ColumnDefinition Width="30*" />
                  <ColumnDefinition Width="5*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="Имя (серийник)" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="Состояние"      FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="Сохранение"     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="Активна"        FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="Путь к папке"   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Строки флешек -->
            <ListView
                x:Name="DriveList"
                HorizontalContentAlignment="Stretch"
                SelectionMode="Single"
                Grid.Row="1"
                SelectionChanged="OnListSelectionChanged"
                DoubleTapped="OnListDoubleTapped"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

              <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:DriveRow">
                  <Grid Padding="12,8,12,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="25*" />
                      <ColumnDefinition Width="15*" />
                      <ColumnDefinition Width="15*" />
                      <ColumnDefinition Width="10*" />
                      <ColumnDefinition Width="30*" />
                      <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind State, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind BackupState, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

                    <CheckBox
                        Grid.Column="3"
                        IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                        Checked="OnRowEnabledChecked"
                        Unchecked="OnRowEnabledUnchecked"
                        HorizontalAlignment="Center"
                         MinWidth="0" />

                    <TextBlock
                        Grid.Column="4"
                        Text="{x:Bind BackupPath}"
                        TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind BackupPath}" />

                    <Button
                        Grid.Column="5"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="PerDriveSettings_Click"
                        ToolTipService.ToolTip="Настройки флешки"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        Padding="4,2,4,2">
                      <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>

              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="36" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </Grid>
        </Border>

        <!-- Иконка в трее создаётся в коде (NativeTrayIcon) — вне визуального дерева. -->
      </Grid>
    </TabViewItem>

    <TabViewItem Header="Настройки" IsClosable="False">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Padding="24,20,24,24" Spacing="12">
          <TextBlock Text="Глобальные настройки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

          <CheckBox x:Name="ChkMirror"   Content="Зеркало"             Checked="OnMirrorChecked"   Unchecked="OnMirrorUnchecked" />
          <CheckBox x:Name="ChkCrc"      Content="Проверять CRC32"     Checked="OnCrcChecked"      Unchecked="OnCrcUnchecked" />
          <CheckBox x:Name="ChkStartup"  Content="Запускать с Windows" Checked="OnStartupChecked"  Unchecked="OnStartupUnchecked" />
          <CheckBox x:Name="ChkLiveWatch" Content="Обновлять сразу (watch)" Checked="OnLiveChecked" Unchecked="OnLiveUnchecked" ToolTipService.ToolTip="Если включено — изменения на флешке сразу копируются." />
        </StackPanel>
      </ScrollViewer>
    </TabViewItem>

  </TabView>
</Window>
